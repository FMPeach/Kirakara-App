+
+namespace flutter {
+namespace egl {
+
+class Manager;
+
+// A Flutter render surface backed by a premultiplied-alpha composition
+// swapchain. Its lower sibling is either the Phase 2 synthetic producer or an
+// event-driven consumer of the latest keyed-mutex Stage frame. Neither path
+// calls into Flutter or depends on the Flutter frame pump.
+class CompositionWindowSurface final : public WindowSurface {
+ public:
+  static std::unique_ptr<CompositionWindowSurface> Create(
+      Manager* manager,
+      const KirakaraFlutterCompositorConfig& config,
+      const std::shared_ptr<KirakaraCompositorState>& state,
+      size_t width,
+      size_t height);
+
+  ~CompositionWindowSurface() override;
+
+  bool Destroy() override;
+  bool IsValid() const override;
+  bool IsCurrent() const override;
+  bool MakeCurrent() const override;
+  bool SwapBuffers() const override;
+  const EGLSurface& GetHandle() const override;
+  bool SetVSyncEnabled(bool enabled) override;
+  size_t width() const override;
+  size_t height() const override;
+  bool vsync_enabled() const override;
+
+  // Resizes the Flutter composition swapchain without detaching the
+  // DirectComposition root from the HWND. Synthetic Stage follows the window;
+  // external Stage retains source dimensions and is transformed by its Visual.
+  bool Resize(size_t width, size_t height);
+
+ private:
+  using WaitForCompositorClockProc = DWORD(WINAPI*)(UINT count,
+                                                    const HANDLE* handles,
+                                                    DWORD timeout_ms);
+
+  struct FlutterBuffer {
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> texture;
+    EGLSurface surface = EGL_NO_SURFACE;
+  };
+
+  CompositionWindowSurface(Manager* manager,
+                           const KirakaraFlutterCompositorConfig& config,
+                           std::shared_ptr<KirakaraCompositorState> state,
+                           size_t width,
+                           size_t height);
+
+  bool Initialize();
+  bool CreateFlutterSwapChain(ID3D11Device* angle_device,
+                              IDXGIFactory2* factory);
+  bool CreateCompositionTree(IDXGIDevice* angle_dxgi_device);
+  bool CreateStageDevice(IDXGIAdapter* adapter, IDXGIFactory2* factory);
+  bool CreateSyntheticStage(IDXGIAdapter* adapter, IDXGIFactory2* factory);
+  bool CreateExternalStagePlaceholder();
+  bool CreateFlutterEglSurface(ID3D11Device* angle_device);
+  void StartStageProducer(bool render_initial_frame = true) const;
+  void StopStageProducer();
+  void StageProducerMain(bool render_initial_frame) const;
+  void ExternalStageConsumerMain() const;
+  HRESULT RenderSyntheticStage(uint64_t frame_number) const;
+  HRESULT ConsumeExternalStageFrame(KirakaraStageUpdate* update,
+                                    bool geometry_changed) const;
+  HRESULT OpenExternalStageResource(KirakaraStageUpdate* update) const;
+  HRESULT EnsureExternalStageSwapChain(uint32_t width, uint32_t height) const;
+  HRESULT ApplyExternalStageGeometry(bool force_commit) const;
+  HRESULT DetachExternalStageVisual() const;
+  bool synthetic_stage() const;
+  bool external_stage() const;
+  bool Fail(HRESULT result, const char* operation);
+
+  Manager* manager_ = nullptr;
+  KirakaraFlutterCompositorConfig config_{};
+  std::shared_ptr<KirakaraCompositorState> state_;
+  size_t width_ = 0;
