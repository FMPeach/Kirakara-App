new file mode 100644
index 0000000000000000000000000000000000000000..06f63d31635f0b05d9464108782038629dc737e6
--- /dev/null
+++ b/engine/src/flutter/shell/platform/windows/kirakara_compositor.cc
@@ -0,0 +1,439 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/windows/kirakara_compositor.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <iterator>
+#include <mutex>
+#include <unordered_map>
+
+#include "flutter/shell/platform/common/public/flutter_export.h"
+
+namespace flutter {
+namespace {
+
+std::mutex g_state_mutex;
+std::optional<KirakaraFlutterCompositorConfig> g_prepared_config;
+std::unordered_map<uintptr_t, std::weak_ptr<KirakaraCompositorState>>
+    g_view_states;
+
+bool ReservedFieldsAreZero(const uint64_t (&reserved)[4]) {
+  return std::all_of(std::begin(reserved), std::end(reserved),
+                     [](uint64_t value) { return value == 0; });
+}
+
+bool IsExternalStageConfig(const KirakaraFlutterCompositorConfig& config) {
+  return (config.flags & kKirakaraFlutterCompositorExternalStage) != 0;
+}
+
+std::shared_ptr<KirakaraCompositorState> FindViewState(uintptr_t view) {
+  if (!view) {
+    return nullptr;
+  }
+  std::scoped_lock lock(g_state_mutex);
+  const auto found = g_view_states.find(view);
+  return found == g_view_states.end() ? nullptr : found->second.lock();
+}
+
+bool IsValidTopLevelWindow(uintptr_t window_value) {
+  const HWND window = reinterpret_cast<HWND>(window_value);
+  if (!window || !::IsWindow(window) ||
+      ::GetAncestor(window, GA_ROOT) != window ||
+      (::GetWindowLongPtrW(window, GWL_STYLE) & WS_CHILD) != 0) {
+    return false;
+  }
+  DWORD process_id = 0;
+  ::GetWindowThreadProcessId(window, &process_id);
+  return process_id == ::GetCurrentProcessId();
+}
+
+int32_t PrepareNextView(const KirakaraFlutterCompositorConfig* config) {
+  constexpr uint32_t kSupportedFlags =
+      kKirakaraFlutterCompositorSyntheticStage |
+      kKirakaraFlutterCompositorRequireComposition |
+      kKirakaraFlutterCompositorExternalStage;
+  if (!config || config->struct_size != sizeof(*config) ||
+      config->abi_version != KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION ||
+      config->patchset_version !=
+          KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION) {
+    return kKirakaraFlutterCompositorVersionMismatch;
+  }
+  const uint32_t selected_stage_modes =
+      config->flags & (kKirakaraFlutterCompositorSyntheticStage |
+                       kKirakaraFlutterCompositorExternalStage);
+  if ((config->flags & ~kSupportedFlags) != 0 ||
+      (config->flags & kKirakaraFlutterCompositorRequireComposition) == 0 ||
+      (selected_stage_modes != kKirakaraFlutterCompositorSyntheticStage &&
+       selected_stage_modes != kKirakaraFlutterCompositorExternalStage) ||
+      !ReservedFieldsAreZero(config->reserved) ||
+      !IsValidTopLevelWindow(config->top_level_window)) {
+    return kKirakaraFlutterCompositorInvalidArgument;
+  }
+
+  std::scoped_lock lock(g_state_mutex);
+  if (g_prepared_config.has_value()) {
+    return kKirakaraFlutterCompositorBusy;
+  }
+  g_prepared_config = *config;
+  return kKirakaraFlutterCompositorSuccess;
+}
+
+int32_t CancelPreparedView() {
+  std::scoped_lock lock(g_state_mutex);
+  if (!g_prepared_config.has_value()) {
+    return kKirakaraFlutterCompositorViewNotConfigured;
+  }
+  g_prepared_config.reset();
+  return kKirakaraFlutterCompositorSuccess;
+}
+
+int32_t GetViewDiagnostics(uintptr_t view,
+                           KirakaraFlutterCompositorDiagnostics* diagnostics) {
+  if (!view || !diagnostics) {
+    return kKirakaraFlutterCompositorInvalidArgument;
+  }
+  if (diagnostics->struct_size != sizeof(*diagnostics) ||
+      diagnostics->abi_version != KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION ||
+      diagnostics->patchset_version !=
+          KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION) {
+    return kKirakaraFlutterCompositorVersionMismatch;
+  }
+
+  const auto state = FindViewState(view);
+  if (!state) {
+    return kKirakaraFlutterCompositorViewNotConfigured;
+  }
+
+  KirakaraFlutterCompositorDiagnostics result{};
+  result.struct_size = sizeof(result);
+  result.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  result.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  result.active = state->active.load(std::memory_order_acquire) ? 1u : 0u;
+  result.capabilities = state->capabilities.load(std::memory_order_acquire);
+  result.top_level_window = state->config.top_level_window;
+  result.width = state->width.load(std::memory_order_relaxed);
+  result.height = state->height.load(std::memory_order_relaxed);
+  result.initialization_hresult =
+      state->initialization_hresult.load(std::memory_order_relaxed);
+  result.last_stage_present_hresult =
+      state->last_stage_present_hresult.load(std::memory_order_relaxed);
+  result.last_stage_pacing_status =
+      state->last_stage_pacing_status.load(std::memory_order_relaxed);
+  result.last_resize_hresult =
+      state->last_resize_hresult.load(std::memory_order_relaxed);
+  result.flutter_present_count =
+      state->flutter_present_count.load(std::memory_order_relaxed);
+  result.stage_present_count =
+      state->stage_present_count.load(std::memory_order_relaxed);
+  result.stage_wait_wake_count =
+      state->stage_wait_wake_count.load(std::memory_order_relaxed);
+  result.stage_device_removed_count =
+      state->stage_device_removed_count.load(std::memory_order_relaxed);
+  result.stage_occluded_count =
+      state->stage_occluded_count.load(std::memory_order_relaxed);
+  result.surface_resize_count =
+      state->surface_resize_count.load(std::memory_order_relaxed);
+  result.composition_tree_commit_count =
+      state->composition_tree_commit_count.load(std::memory_order_relaxed);
+  result.last_stage_resource_hresult =
+      state->last_stage_resource_hresult.load(std::memory_order_relaxed);
+  result.stage_frame_submit_count =
+      state->stage_frame_submit_count.load(std::memory_order_relaxed);
+  result.stage_frame_coalesced_count =
+      state->stage_frame_coalesced_count.load(std::memory_order_relaxed);
+  result.stage_frame_stale_count =
+      state->stage_frame_stale_count.load(std::memory_order_relaxed);
+  result.stage_handle_duplicate_failure_count =
+      state->stage_handle_duplicate_failure_count.load(
+          std::memory_order_relaxed);
+  result.stage_resource_open_failure_count =
+      state->stage_resource_open_failure_count.load(std::memory_order_relaxed);
+  result.stage_acquire_busy_count =
+      state->stage_acquire_busy_count.load(std::memory_order_relaxed);
+  result.stage_detach_count =
+      state->stage_detach_count.load(std::memory_order_relaxed);
+  result.stage_geometry_update_count =
+      state->stage_geometry_update_count.load(std::memory_order_relaxed);
+  result.stage_resource_generation =
+      state->stage_resource_generation.load(std::memory_order_relaxed);
+  result.stage_content_generation =
+      state->stage_content_generation.load(std::memory_order_relaxed);
+  result.stage_frame_id = state->stage_frame_id.load(std::memory_order_relaxed);
+  *diagnostics = result;
+  return kKirakaraFlutterCompositorSuccess;
+}
+
+int32_t SubmitStageFrame(uintptr_t view,
+                         const KirakaraFlutterCompositorStageFrame* frame) {
+  const auto state = FindViewState(view);
+  return state ? state->SubmitStageFrame(frame)
+               : kKirakaraFlutterCompositorViewNotConfigured;
+}
+
+int32_t SetStageGeometry(
+    uintptr_t view,
+    const KirakaraFlutterCompositorStageGeometry* geometry) {
+  const auto state = FindViewState(view);
+  return state ? state->SetStageGeometry(geometry)
+               : kKirakaraFlutterCompositorViewNotConfigured;
+}
+
+int32_t DetachStage(uintptr_t view) {
+  const auto state = FindViewState(view);
+  return state ? state->DetachStage()
+               : kKirakaraFlutterCompositorViewNotConfigured;
+}
+
+}  // namespace
+
+KirakaraCompositorState::KirakaraCompositorState(
+    const KirakaraFlutterCompositorConfig& configuration)
+    : config(configuration) {
+  stage_update_event = ::CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  stage_geometry_.struct_size = sizeof(stage_geometry_);
+  stage_geometry_.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  stage_geometry_.patchset_version =
+      KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  stage_geometry_.fit = kKirakaraFlutterCompositorStageFitContain;
+}
+
+KirakaraCompositorState::~KirakaraCompositorState() {
+  {
+    std::scoped_lock lock(stage_mailbox_mutex_);
+    if (pending_nt_handle_) {
+      ::CloseHandle(pending_nt_handle_);
+      pending_nt_handle_ = nullptr;
+    }
+  }
+  if (stage_update_event) {
+    ::CloseHandle(stage_update_event);
+    stage_update_event = nullptr;
+  }
+}
+
+int32_t KirakaraCompositorState::SubmitStageFrame(
+    const KirakaraFlutterCompositorStageFrame* frame) {
+  constexpr uint32_t kSupportedFlags =
+      kKirakaraFlutterCompositorStageResourceChanged;
+  constexpr uint32_t kBgra8888Unorm = 87u;
+  if (!frame || frame->struct_size != sizeof(*frame) ||
+      frame->abi_version != KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION ||
+      frame->patchset_version != KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION) {
+    return kKirakaraFlutterCompositorVersionMismatch;
+  }
+  if (!external_stage() || !stage_update_event ||
+      (frame->flags & ~kSupportedFlags) != 0 ||
+      frame->sync_type != kKirakaraFlutterCompositorStageSyncKeyedMutex ||
+      frame->shared_nt_handle == 0 || frame->width == 0 || frame->height == 0 ||
+      frame->width > 16384 || frame->height > 16384 ||
+      frame->dxgi_format != kBgra8888Unorm || frame->resource_generation == 0 ||
+      frame->consumer_acquire_key == frame->consumer_release_key ||
+      !ReservedFieldsAreZero(frame->reserved)) {
+    return kKirakaraFlutterCompositorInvalidArgument;
+  }
+
+  std::scoped_lock lock(stage_mailbox_mutex_);
+  const bool new_resource =
+      frame->resource_generation != submitted_resource_generation_;
+  if (submitted_resource_generation_ != 0 &&
+      frame->resource_generation < submitted_resource_generation_) {
+    stage_frame_stale_count.fetch_add(1, std::memory_order_relaxed);
+    return kKirakaraFlutterCompositorFrameDropped;
+  }
+  if (!new_resource &&
+      (frame->content_generation < submitted_content_generation_ ||
+       (frame->content_generation == submitted_content_generation_ &&
+        frame->frame_id <= submitted_frame_id_))) {
+    stage_frame_stale_count.fetch_add(1, std::memory_order_relaxed);
+    return kKirakaraFlutterCompositorFrameDropped;
+  }
+
+  HANDLE duplicated_handle = nullptr;
+  if (new_resource) {
+    if (!::DuplicateHandle(::GetCurrentProcess(),
+                           reinterpret_cast<HANDLE>(frame->shared_nt_handle),
+                           ::GetCurrentProcess(), &duplicated_handle, 0, FALSE,
+                           DUPLICATE_SAME_ACCESS)) {
+      const HRESULT result = HRESULT_FROM_WIN32(::GetLastError());
+      last_stage_resource_hresult.store(result, std::memory_order_relaxed);
+      stage_handle_duplicate_failure_count.fetch_add(1,
+                                                     std::memory_order_relaxed);
+      return kKirakaraFlutterCompositorOperationFailed;
+    }
+  }
+
+  if (pending_stage_frame_) {
+    stage_frame_coalesced_count.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (new_resource) {
+    if (pending_nt_handle_) {
+      ::CloseHandle(pending_nt_handle_);
+    }
+    pending_nt_handle_ = duplicated_handle;
+    submitted_resource_generation_ = frame->resource_generation;
+  }
+  pending_frame_ = *frame;
+  pending_stage_frame_ = true;
+  submitted_content_generation_ = frame->content_generation;
+  submitted_frame_id_ = frame->frame_id;
+  stage_frame_submit_count.fetch_add(1, std::memory_order_relaxed);
+  if (!::SetEvent(stage_update_event)) {
+    last_stage_resource_hresult.store(HRESULT_FROM_WIN32(::GetLastError()),
+                                      std::memory_order_relaxed);
+    return kKirakaraFlutterCompositorOperationFailed;
+  }
+  return kKirakaraFlutterCompositorSuccess;
+}
+
+int32_t KirakaraCompositorState::SetStageGeometry(
+    const KirakaraFlutterCompositorStageGeometry* geometry) {
+  if (!geometry || geometry->struct_size != sizeof(*geometry) ||
+      geometry->abi_version != KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION ||
+      geometry->patchset_version !=
+          KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION) {
+    return kKirakaraFlutterCompositorVersionMismatch;
+  }
+  const bool finite =
+      std::isfinite(geometry->x) && std::isfinite(geometry->y) &&
+      std::isfinite(geometry->width) && std::isfinite(geometry->height);
+  if (!external_stage() || !stage_update_event || !finite ||
+      geometry->visible > 1 || geometry->width < 0.0f ||
+      geometry->height < 0.0f || geometry->width > 16384.0f ||
+      geometry->height > 16384.0f || geometry->x < -16384.0f ||
+      geometry->y < -16384.0f || geometry->x > 16384.0f ||
+      geometry->y > 16384.0f ||
+      (geometry->visible != 0 &&
+       (geometry->width == 0.0f || geometry->height == 0.0f)) ||
+      geometry->fit > kKirakaraFlutterCompositorStageFitFill ||
+      geometry->reserved0 != 0 || !ReservedFieldsAreZero(geometry->reserved)) {
+    return kKirakaraFlutterCompositorInvalidArgument;
+  }
+
+  {
+    std::scoped_lock lock(stage_mailbox_mutex_);
+    if (std::memcmp(&stage_geometry_, geometry, sizeof(*geometry)) == 0) {
+      return kKirakaraFlutterCompositorSuccess;
+    }
+    stage_geometry_ = *geometry;
+    ++stage_geometry_sequence_;
+    stage_geometry_update_count.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (!::SetEvent(stage_update_event)) {
+    last_stage_resource_hresult.store(HRESULT_FROM_WIN32(::GetLastError()),
+                                      std::memory_order_relaxed);
+    return kKirakaraFlutterCompositorOperationFailed;
+  }
+  return kKirakaraFlutterCompositorSuccess;
+}
+
+int32_t KirakaraCompositorState::DetachStage() {
+  if (!external_stage() || !stage_update_event) {
+    return kKirakaraFlutterCompositorUnavailable;
+  }
+  {
+    std::scoped_lock lock(stage_mailbox_mutex_);
+    if (pending_nt_handle_) {
+      ::CloseHandle(pending_nt_handle_);
+      pending_nt_handle_ = nullptr;
+    }
+    pending_stage_frame_ = false;
+    pending_frame_ = {};
+    submitted_resource_generation_ = 0;
+    submitted_content_generation_ = 0;
+    submitted_frame_id_ = 0;
+    ++stage_detach_sequence_;
+    stage_detach_count.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (!::SetEvent(stage_update_event)) {
+    last_stage_resource_hresult.store(HRESULT_FROM_WIN32(::GetLastError()),
+                                      std::memory_order_relaxed);
+    return kKirakaraFlutterCompositorOperationFailed;
+  }
+  return kKirakaraFlutterCompositorSuccess;
+}
+
+KirakaraStageUpdate KirakaraCompositorState::TakeLatestStageUpdate() {
+  std::scoped_lock lock(stage_mailbox_mutex_);
+  KirakaraStageUpdate update{};
+  update.has_frame = pending_stage_frame_;
+  update.frame = pending_frame_;
+  update.duplicated_nt_handle = pending_nt_handle_;
+  update.geometry = stage_geometry_;
+  update.geometry_sequence = stage_geometry_sequence_;
+  update.detach_sequence = stage_detach_sequence_;
+  pending_stage_frame_ = false;
+  pending_frame_ = {};
+  pending_nt_handle_ = nullptr;
+  return update;
+}
+
+void KirakaraCompositorState::ResetSubmittedResourceAfterOpenFailure(
+    uint64_t resource_generation) {
+  std::scoped_lock lock(stage_mailbox_mutex_);
+  if (submitted_resource_generation_ != resource_generation) {
+    return;
+  }
+  submitted_resource_generation_ = 0;
+  submitted_content_generation_ = 0;
+  submitted_frame_id_ = 0;
+  if (pending_stage_frame_ &&
+      pending_frame_.resource_generation == resource_generation &&
+      !pending_nt_handle_) {
+    pending_stage_frame_ = false;
+    pending_frame_ = {};
+    stage_frame_coalesced_count.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+std::optional<KirakaraFlutterCompositorConfig>
+TakePreparedKirakaraCompositorConfig() {
+  std::scoped_lock lock(g_state_mutex);
+  auto config = g_prepared_config;
+  g_prepared_config.reset();
+  return config;
+}
+
+void RegisterKirakaraCompositorView(
+    uintptr_t view,
+    const std::shared_ptr<KirakaraCompositorState>& state) {
+  std::scoped_lock lock(g_state_mutex);
+  g_view_states[view] = state;
+}
+
+void UnregisterKirakaraCompositorView(uintptr_t view) {
+  std::scoped_lock lock(g_state_mutex);
+  g_view_states.erase(view);
+}
+
+}  // namespace flutter
+
+extern "C" FLUTTER_EXPORT int32_t
+FlutterDesktopKirakaraCompositorGetApi(uint32_t requested_abi_version,
+                                       KirakaraFlutterCompositorApi* api) {
+  if (!api) {
+    return kKirakaraFlutterCompositorInvalidArgument;
+  }
+  if (requested_abi_version != KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION ||
+      api->struct_size != sizeof(*api)) {
+    return kKirakaraFlutterCompositorVersionMismatch;
+  }
+
+  KirakaraFlutterCompositorApi result{};
+  result.struct_size = sizeof(result);
+  result.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  result.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  result.patchset_revision = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_REVISION;
+  result.engine_revision = KIRAKARA_FLUTTER_COMPOSITOR_ENGINE_REVISION;
+  result.prepare_next_view = flutter::PrepareNextView;
+  result.cancel_prepared_view = flutter::CancelPreparedView;
+  result.get_view_diagnostics = flutter::GetViewDiagnostics;
+  result.submit_stage_frame = flutter::SubmitStageFrame;
+  result.set_stage_geometry = flutter::SetStageGeometry;
+  result.detach_stage = flutter::DetachStage;
+  *api = result;
+  return kKirakaraFlutterCompositorSuccess;
+}
