+#ifndef FLUTTER_SHELL_PLATFORM_WINDOWS_EGL_COMPOSITION_WINDOW_SURFACE_H_
+#define FLUTTER_SHELL_PLATFORM_WINDOWS_EGL_COMPOSITION_WINDOW_SURFACE_H_
+
+#include <d3d11.h>
+#include <d3d11_1.h>
+#include <dcomp.h>
