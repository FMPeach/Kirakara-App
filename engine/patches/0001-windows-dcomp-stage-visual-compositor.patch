+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/windows/kirakara_compositor.h"
+
+#include <algorithm>
+#include <iterator>
+#include <memory>
+
+#include "gtest/gtest.h"
+
+extern "C" int32_t FlutterDesktopKirakaraCompositorGetApi(
+    uint32_t requested_abi_version,
+    KirakaraFlutterCompositorApi* api);
+
+namespace flutter {
+namespace testing {
+namespace {
+
+constexpr wchar_t kTestWindowClass[] = L"KirakaraCompositorApiTestWindow";
+
+KirakaraFlutterCompositorApi GetApi() {
+  KirakaraFlutterCompositorApi api{};
+  api.struct_size = sizeof(api);
+  EXPECT_EQ(FlutterDesktopKirakaraCompositorGetApi(
+                KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION, &api),
+            kKirakaraFlutterCompositorSuccess);
+  return api;
+}
+
+class KirakaraCompositorApiTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    api_ = GetApi();
+
+    WNDCLASSW window_class{};
+    window_class.lpfnWndProc = ::DefWindowProcW;
+    window_class.hInstance = ::GetModuleHandleW(nullptr);
+    window_class.lpszClassName = kTestWindowClass;
+    ASSERT_NE(::RegisterClassW(&window_class), 0u);
+
+    window_ = ::CreateWindowExW(
+        0, kTestWindowClass, L"Kirakara compositor API test",
+        WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, 320, 240, nullptr,
+        nullptr, window_class.hInstance, nullptr);
+    ASSERT_NE(window_, nullptr);
+  }
+
+  void TearDown() override {
+    TakePreparedKirakaraCompositorConfig();
+    if (registered_view_ != 0) {
+      UnregisterKirakaraCompositorView(registered_view_);
+      registered_view_ = 0;
+    }
+    if (window_) {
+      ::DestroyWindow(window_);
+      window_ = nullptr;
+    }
+    ::UnregisterClassW(kTestWindowClass, ::GetModuleHandleW(nullptr));
+  }
+
+  KirakaraFlutterCompositorConfig ValidConfig() const {
+    KirakaraFlutterCompositorConfig config{};
+    config.struct_size = sizeof(config);
+    config.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+    config.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+    config.flags = kKirakaraFlutterCompositorSyntheticStage |
+                   kKirakaraFlutterCompositorRequireComposition;
+    config.top_level_window = reinterpret_cast<uintptr_t>(window_);
+    return config;
+  }
+
+  KirakaraFlutterCompositorConfig ValidExternalConfig() const {
+    auto config = ValidConfig();
+    config.flags = kKirakaraFlutterCompositorExternalStage |
+                   kKirakaraFlutterCompositorRequireComposition;
+    return config;
+  }
+
+  KirakaraFlutterCompositorApi api_{};
+  HWND window_ = nullptr;
+  uintptr_t registered_view_ = 0;
+};
+
+TEST(KirakaraCompositorApiExportTest, ValidatesVersionAndPublishesMetadata) {
+  EXPECT_EQ(FlutterDesktopKirakaraCompositorGetApi(
+                KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION, nullptr),
+            kKirakaraFlutterCompositorInvalidArgument);
+
+  KirakaraFlutterCompositorApi api{};
+  EXPECT_EQ(FlutterDesktopKirakaraCompositorGetApi(
+                KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION, &api),
+            kKirakaraFlutterCompositorVersionMismatch);
+
+  api.struct_size = sizeof(api);
+  EXPECT_EQ(FlutterDesktopKirakaraCompositorGetApi(
+                KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION + 1, &api),
+            kKirakaraFlutterCompositorVersionMismatch);
+  EXPECT_EQ(FlutterDesktopKirakaraCompositorGetApi(
+                KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION, &api),
+            kKirakaraFlutterCompositorSuccess);
+  EXPECT_EQ(api.struct_size, sizeof(api));
+  EXPECT_EQ(api.abi_version, KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION);
+  EXPECT_EQ(api.patchset_version, KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION);
+  EXPECT_STREQ(api.patchset_revision,
+               KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_REVISION);
+  EXPECT_STREQ(api.engine_revision,
+               KIRAKARA_FLUTTER_COMPOSITOR_ENGINE_REVISION);
+  EXPECT_NE(api.prepare_next_view, nullptr);
+  EXPECT_NE(api.cancel_prepared_view, nullptr);
+  EXPECT_NE(api.get_view_diagnostics, nullptr);
+  EXPECT_NE(api.submit_stage_frame, nullptr);
+  EXPECT_NE(api.set_stage_geometry, nullptr);
+  EXPECT_NE(api.detach_stage, nullptr);
+  EXPECT_TRUE(std::all_of(std::begin(api.reserved), std::end(api.reserved),
+                          [](uint64_t value) { return value == 0; }));
+}
+
+TEST_F(KirakaraCompositorApiTest, PrepareValidatesAndSerializesNextView) {
+  EXPECT_EQ(api_.prepare_next_view(nullptr),
+            kKirakaraFlutterCompositorVersionMismatch);
+
+  auto config = ValidConfig();
+  config.abi_version++;
+  EXPECT_EQ(api_.prepare_next_view(&config),
+            kKirakaraFlutterCompositorVersionMismatch);
+
+  config = ValidConfig();
+  config.top_level_window = 1;
+  EXPECT_EQ(api_.prepare_next_view(&config),
+            kKirakaraFlutterCompositorInvalidArgument);
+
+  config = ValidConfig();
+  config.flags = kKirakaraFlutterCompositorSyntheticStage;
+  EXPECT_EQ(api_.prepare_next_view(&config),
+            kKirakaraFlutterCompositorInvalidArgument);
+
+  config = ValidConfig();
+  config.flags = kKirakaraFlutterCompositorSyntheticStage |
+                 kKirakaraFlutterCompositorExternalStage |
+                 kKirakaraFlutterCompositorRequireComposition;
+  EXPECT_EQ(api_.prepare_next_view(&config),
+            kKirakaraFlutterCompositorInvalidArgument);
+
+  config = ValidExternalConfig();
+  EXPECT_EQ(api_.prepare_next_view(&config), kKirakaraFlutterCompositorSuccess);
+  EXPECT_EQ(api_.cancel_prepared_view(), kKirakaraFlutterCompositorSuccess);
+
+  config = ValidConfig();
+  config.reserved[2] = 1;
+  EXPECT_EQ(api_.prepare_next_view(&config),
+            kKirakaraFlutterCompositorInvalidArgument);
+
+  config = ValidConfig();
+  EXPECT_EQ(api_.prepare_next_view(&config), kKirakaraFlutterCompositorSuccess);
+  EXPECT_EQ(api_.prepare_next_view(&config), kKirakaraFlutterCompositorBusy);
+  EXPECT_EQ(api_.cancel_prepared_view(), kKirakaraFlutterCompositorSuccess);
+  EXPECT_EQ(api_.cancel_prepared_view(),
+            kKirakaraFlutterCompositorViewNotConfigured);
+}
+
+TEST_F(KirakaraCompositorApiTest,
+       ExternalStageMailboxKeepsLatestFrameAndOwnedHandle) {
+  const auto config = ValidExternalConfig();
+  auto state = std::make_shared<KirakaraCompositorState>(config);
+  ASSERT_NE(state->stage_update_event, nullptr);
+  registered_view_ = reinterpret_cast<uintptr_t>(state.get());
+  RegisterKirakaraCompositorView(registered_view_, state);
+
+  HANDLE borrowed_handle = ::CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  ASSERT_NE(borrowed_handle, nullptr);
+  KirakaraFlutterCompositorStageFrame frame{};
+  frame.struct_size = sizeof(frame);
+  frame.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  frame.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  frame.flags = kKirakaraFlutterCompositorStageResourceChanged;
+  frame.shared_nt_handle = reinterpret_cast<uintptr_t>(borrowed_handle);
+  frame.width = 1920;
+  frame.height = 1080;
+  frame.dxgi_format = 87;
+  frame.sync_type = kKirakaraFlutterCompositorStageSyncKeyedMutex;
+  frame.resource_generation = 4;
+  frame.content_generation = 9;
+  frame.frame_id = 31;
+  frame.consumer_acquire_key = 1;
+  frame.consumer_release_key = 0;
+  ASSERT_EQ(api_.submit_stage_frame(registered_view_, &frame),
+            kKirakaraFlutterCompositorSuccess);
+
+  frame.flags = 0;
+  frame.frame_id = 32;
+  ASSERT_EQ(api_.submit_stage_frame(registered_view_, &frame),
+            kKirakaraFlutterCompositorSuccess);
+  EXPECT_EQ(api_.submit_stage_frame(registered_view_, &frame),
+            kKirakaraFlutterCompositorFrameDropped);
+  ASSERT_TRUE(::CloseHandle(borrowed_handle));
+
+  auto update = state->TakeLatestStageUpdate();
+  EXPECT_TRUE(update.has_frame);
+  EXPECT_EQ(update.frame.frame_id, 32u);
+  ASSERT_NE(update.duplicated_nt_handle, nullptr);
+  DWORD handle_flags = 0;
+  EXPECT_TRUE(
+      ::GetHandleInformation(update.duplicated_nt_handle, &handle_flags));
+  EXPECT_TRUE(::CloseHandle(update.duplicated_nt_handle));
+  update.duplicated_nt_handle = nullptr;
+
+  KirakaraFlutterCompositorDiagnostics diagnostics{};
+  diagnostics.struct_size = sizeof(diagnostics);
+  diagnostics.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  diagnostics.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  ASSERT_EQ(api_.get_view_diagnostics(registered_view_, &diagnostics),
+            kKirakaraFlutterCompositorSuccess);
+  EXPECT_EQ(diagnostics.stage_frame_submit_count, 2u);
+  EXPECT_EQ(diagnostics.stage_frame_coalesced_count, 1u);
+  EXPECT_EQ(diagnostics.stage_frame_stale_count, 1u);
+}
+
+TEST_F(KirakaraCompositorApiTest,
+       ExternalStageGeometryAndDetachAreVersionedAndEventDriven) {
+  const auto config = ValidExternalConfig();
+  auto state = std::make_shared<KirakaraCompositorState>(config);
+  registered_view_ = reinterpret_cast<uintptr_t>(state.get());
+  RegisterKirakaraCompositorView(registered_view_, state);
+
+  KirakaraFlutterCompositorStageGeometry geometry{};
+  geometry.struct_size = sizeof(geometry);
+  geometry.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  geometry.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  geometry.visible = 1;
+  geometry.x = 25.0f;
+  geometry.y = 40.0f;
+  geometry.width = 1280.0f;
+  geometry.height = 720.0f;
+  geometry.fit = kKirakaraFlutterCompositorStageFitContain;
+  ASSERT_EQ(api_.set_stage_geometry(registered_view_, &geometry),
+            kKirakaraFlutterCompositorSuccess);
+  // An identical geometry does not manufacture another update.
+  ASSERT_EQ(api_.set_stage_geometry(registered_view_, &geometry),
+            kKirakaraFlutterCompositorSuccess);
+
+  auto update = state->TakeLatestStageUpdate();
+  EXPECT_FALSE(update.has_frame);
+  EXPECT_EQ(update.geometry_sequence, 1u);
+  EXPECT_EQ(update.geometry.width, 1280.0f);
+
+  geometry.reserved[1] = 1;
+  EXPECT_EQ(api_.set_stage_geometry(registered_view_, &geometry),
+            kKirakaraFlutterCompositorInvalidArgument);
+  EXPECT_EQ(api_.detach_stage(registered_view_),
+            kKirakaraFlutterCompositorSuccess);
+  update = state->TakeLatestStageUpdate();
+  EXPECT_EQ(update.detach_sequence, 1u);
+
+  KirakaraFlutterCompositorDiagnostics diagnostics{};
+  diagnostics.struct_size = sizeof(diagnostics);
+  diagnostics.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  diagnostics.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  ASSERT_EQ(api_.get_view_diagnostics(registered_view_, &diagnostics),
+            kKirakaraFlutterCompositorSuccess);
+  EXPECT_EQ(diagnostics.stage_geometry_update_count, 1u);
+  EXPECT_EQ(diagnostics.stage_detach_count, 1u);
+}
+
+TEST_F(KirakaraCompositorApiTest, PreparedConfigurationIsConsumedOnce) {
+  const auto config = ValidConfig();
+  ASSERT_EQ(api_.prepare_next_view(&config), kKirakaraFlutterCompositorSuccess);
+
+  const auto prepared = TakePreparedKirakaraCompositorConfig();
+  ASSERT_TRUE(prepared.has_value());
+  EXPECT_EQ(prepared->top_level_window, config.top_level_window);
+  EXPECT_EQ(prepared->flags, config.flags);
+  EXPECT_FALSE(TakePreparedKirakaraCompositorConfig().has_value());
+  EXPECT_EQ(api_.cancel_prepared_view(),
+            kKirakaraFlutterCompositorViewNotConfigured);
+}
+
+TEST_F(KirakaraCompositorApiTest,
+       DiagnosticsRequireCompatibleLiveRegisteredState) {
+  KirakaraFlutterCompositorDiagnostics diagnostics{};
+  diagnostics.struct_size = sizeof(diagnostics) - 1;
+  diagnostics.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  diagnostics.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  EXPECT_EQ(api_.get_view_diagnostics(1, &diagnostics),
+            kKirakaraFlutterCompositorVersionMismatch);
+
+  const auto config = ValidConfig();
+  auto state = std::make_shared<KirakaraCompositorState>(config);
+  state->active.store(true);
+  state->capabilities.store(kKirakaraFlutterCompositorDirectComposition |
+                            kKirakaraFlutterCompositorPremultipliedAlpha |
+                            kKirakaraFlutterCompositorCompositorClockPacing);
+  state->width.store(1280);
+  state->height.store(720);
+  state->initialization_hresult.store(S_OK);
+  state->last_stage_present_hresult.store(S_OK);
+  state->last_stage_pacing_status.store(static_cast<int32_t>(0xC01E0006u));
+  state->last_resize_hresult.store(S_OK);
+  state->flutter_present_count.store(7);
+  state->stage_present_count.store(11);
+  state->stage_wait_wake_count.store(10);
+  state->stage_device_removed_count.store(2);
+  state->stage_occluded_count.store(3);
+  state->surface_resize_count.store(4);
+  state->composition_tree_commit_count.store(1);
+
+  registered_view_ = reinterpret_cast<uintptr_t>(state.get());
+  RegisterKirakaraCompositorView(registered_view_, state);
+
+  diagnostics = {};
+  diagnostics.struct_size = sizeof(diagnostics);
+  diagnostics.abi_version = KIRAKARA_FLUTTER_COMPOSITOR_ABI_VERSION;
+  diagnostics.patchset_version = KIRAKARA_FLUTTER_COMPOSITOR_PATCHSET_VERSION;
+  ASSERT_EQ(api_.get_view_diagnostics(registered_view_, &diagnostics),
+            kKirakaraFlutterCompositorSuccess);
+  EXPECT_EQ(diagnostics.active, 1u);
+  EXPECT_EQ(diagnostics.top_level_window, config.top_level_window);
+  EXPECT_EQ(diagnostics.width, 1280u);
+  EXPECT_EQ(diagnostics.height, 720u);
+  EXPECT_EQ(diagnostics.last_stage_pacing_status,
+            static_cast<int32_t>(0xC01E0006u));
+  EXPECT_EQ(diagnostics.last_resize_hresult, S_OK);
+  EXPECT_EQ(diagnostics.flutter_present_count, 7u);
+  EXPECT_EQ(diagnostics.stage_present_count, 11u);
+  EXPECT_EQ(diagnostics.stage_wait_wake_count, 10u);
+  EXPECT_EQ(diagnostics.stage_device_removed_count, 2u);
+  EXPECT_EQ(diagnostics.stage_occluded_count, 3u);
+  EXPECT_EQ(diagnostics.surface_resize_count, 4u);
+  EXPECT_EQ(diagnostics.composition_tree_commit_count, 1u);
+  EXPECT_TRUE(std::all_of(std::begin(diagnostics.reserved),
+                          std::end(diagnostics.reserved),
+                          [](uint64_t value) { return value == 0; }));
+
+  UnregisterKirakaraCompositorView(registered_view_);
+  registered_view_ = 0;
+  EXPECT_EQ(api_.get_view_diagnostics(reinterpret_cast<uintptr_t>(state.get()),
+                                      &diagnostics),
+            kKirakaraFlutterCompositorViewNotConfigured);
+}
