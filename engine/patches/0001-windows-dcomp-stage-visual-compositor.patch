+namespace flutter {
+
+struct KirakaraStageUpdate {
+  bool has_frame = false;
+  KirakaraFlutterCompositorStageFrame frame{};
+  // Owned by the receiver. Null for a frame that reuses the currently opened
+  // resource generation.
+  HANDLE duplicated_nt_handle = nullptr;
+  KirakaraFlutterCompositorStageGeometry geometry{};
+  uint64_t geometry_sequence = 0;
+  uint64_t detach_sequence = 0;
+};
+
+// Per-view state shared by the raster surface, the independent synthetic Stage
+// producer, and the versioned diagnostics export. All fields read by the API
+// are atomic so diagnostics never wait for either graphics thread.
+struct KirakaraCompositorState {
+  explicit KirakaraCompositorState(
+      const KirakaraFlutterCompositorConfig& configuration);
+  ~KirakaraCompositorState();
+
+  KirakaraCompositorState(const KirakaraCompositorState&) = delete;
+  KirakaraCompositorState& operator=(const KirakaraCompositorState&) = delete;
+
+  int32_t SubmitStageFrame(const KirakaraFlutterCompositorStageFrame* frame);
+  int32_t SetStageGeometry(
+      const KirakaraFlutterCompositorStageGeometry* geometry);
+  int32_t DetachStage();
+  KirakaraStageUpdate TakeLatestStageUpdate();
+  void ResetSubmittedResourceAfterOpenFailure(uint64_t resource_generation);
+
+  bool external_stage() const {
+    return (config.flags & kKirakaraFlutterCompositorExternalStage) != 0;
+  }
+
+  KirakaraFlutterCompositorConfig config{};
+  std::atomic_bool active{false};
+  std::atomic_uint64_t capabilities{0};
+  std::atomic_uint32_t width{0};
+  std::atomic_uint32_t height{0};
+  std::atomic_int32_t initialization_hresult{E_PENDING};
+  std::atomic_int32_t last_stage_present_hresult{E_PENDING};
+  std::atomic_int32_t last_stage_pacing_status{0};
+  std::atomic_int32_t last_resize_hresult{E_PENDING};
+  std::atomic_uint64_t flutter_present_count{0};
+  std::atomic_uint64_t stage_present_count{0};
+  std::atomic_uint64_t stage_wait_wake_count{0};
+  std::atomic_uint64_t stage_device_removed_count{0};
+  std::atomic_uint64_t stage_occluded_count{0};
+  std::atomic_uint64_t surface_resize_count{0};
+  std::atomic_uint64_t composition_tree_commit_count{0};
+  std::atomic_int32_t last_stage_resource_hresult{E_PENDING};
+  std::atomic_uint64_t stage_frame_submit_count{0};
+  std::atomic_uint64_t stage_frame_coalesced_count{0};
+  std::atomic_uint64_t stage_frame_stale_count{0};
+  std::atomic_uint64_t stage_handle_duplicate_failure_count{0};
+  std::atomic_uint64_t stage_resource_open_failure_count{0};
+  std::atomic_uint64_t stage_acquire_busy_count{0};
+  std::atomic_uint64_t stage_detach_count{0};
+  std::atomic_uint64_t stage_geometry_update_count{0};
+  std::atomic_uint64_t stage_resource_generation{0};
+  std::atomic_uint64_t stage_content_generation{0};
+  std::atomic_uint64_t stage_frame_id{0};
+
+  // Auto-reset and signaled only by a submitted frame, geometry change, or
+  // detach. The external Stage consumer has no timer or polling loop.
+  HANDLE stage_update_event = nullptr;
+
+ private:
+  std::mutex stage_mailbox_mutex_;
+  bool pending_stage_frame_ = false;
+  KirakaraFlutterCompositorStageFrame pending_frame_{};
+  HANDLE pending_nt_handle_ = nullptr;
+  uint64_t submitted_resource_generation_ = 0;
+  uint64_t submitted_content_generation_ = 0;
+  uint64_t submitted_frame_id_ = 0;
+  KirakaraFlutterCompositorStageGeometry stage_geometry_{};
+  uint64_t stage_geometry_sequence_ = 0;
+  uint64_t stage_detach_sequence_ = 0;
+};
+
+// Consumes the one-shot configuration prepared through the exported API. A
+// normal embedder never calls prepare, so this returns nullopt and the stock
+// surface path is unchanged.
+std::optional<KirakaraFlutterCompositorConfig>
+TakePreparedKirakaraCompositorConfig();
+
+void RegisterKirakaraCompositorView(
+    uintptr_t view,
+    const std::shared_ptr<KirakaraCompositorState>& state);
+void UnregisterKirakaraCompositorView(uintptr_t view);
+
+}  // namespace flutter
+
+#endif  // FLUTTER_SHELL_PLATFORM_WINDOWS_KIRAKARA_COMPOSITOR_H_
