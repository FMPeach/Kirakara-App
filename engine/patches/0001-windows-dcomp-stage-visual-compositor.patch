+std::unique_ptr<CompositionWindowSurface> CompositionWindowSurface::Create(
+    Manager* manager,
+    const KirakaraFlutterCompositorConfig& config,
+    const std::shared_ptr<KirakaraCompositorState>& state,
+    size_t width,
+    size_t height) {
+  auto surface = std::unique_ptr<CompositionWindowSurface>(
+      new CompositionWindowSurface(manager, config, state, width, height));
+  if (!surface->Initialize()) {
+    return nullptr;
+  }
+  return surface;
+}
+
+CompositionWindowSurface::CompositionWindowSurface(
+    Manager* manager,
+    const KirakaraFlutterCompositorConfig& config,
+    std::shared_ptr<KirakaraCompositorState> state,
+    size_t width,
+    size_t height)
+    : WindowSurface(manager ? manager->egl_display() : EGL_NO_DISPLAY,
+                    manager && manager->render_context()
+                        ? manager->render_context()->GetHandle()
+                        : EGL_NO_CONTEXT,
+                    EGL_NO_SURFACE,
+                    width,
+                    height),
+      manager_(manager),
+      config_(config),
+      state_(std::move(state)),
+      width_(width),
+      height_(height) {}
+
+CompositionWindowSurface::~CompositionWindowSurface() {
+  Destroy();
+}
+
+bool CompositionWindowSurface::synthetic_stage() const {
+  return (config_.flags & kKirakaraFlutterCompositorSyntheticStage) != 0;
+}
+
+bool CompositionWindowSurface::external_stage() const {
+  return (config_.flags & kKirakaraFlutterCompositorExternalStage) != 0;
+}
+
+bool CompositionWindowSurface::Initialize() {
+  if (!manager_ || !manager_->IsValid() || !state_ || width_ == 0 ||
+      height_ == 0 || width_ > std::numeric_limits<UINT>::max() ||
+      height_ > std::numeric_limits<UINT>::max()) {
+    return Fail(E_INVALIDARG, "validate composition surface arguments");
+  }
+
+  Microsoft::WRL::ComPtr<ID3D11Device> angle_device;
+  if (!manager_->GetDevice(&angle_device) || !angle_device) {
+    return Fail(E_NOINTERFACE, "resolve ANGLE D3D11 device");
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIDevice> angle_dxgi_device;
+  HRESULT result = angle_device.As(&angle_dxgi_device);
+  if (FAILED(result)) {
+    return Fail(result, "query ANGLE IDXGIDevice");
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+  result = angle_dxgi_device->GetAdapter(&adapter);
+  if (FAILED(result)) {
+    return Fail(result, "resolve ANGLE DXGI adapter");
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIFactory2> factory;
+  result = adapter->GetParent(IID_PPV_ARGS(&factory));
+  if (FAILED(result)) {
+    return Fail(result, "resolve IDXGIFactory2");
+  }
+
+  if ((!synthetic_stage() && !external_stage()) ||
+      (synthetic_stage() && external_stage()) ||
+      (external_stage() && !state_->stage_update_event)) {
+    return Fail(E_INVALIDARG, "validate Stage compositor mode");
+  }
+
+  if (!CreateFlutterSwapChain(angle_device.Get(), factory.Get()) ||
+      !CreateStageDevice(adapter.Get(), factory.Get()) ||
+      (synthetic_stage() &&
+       !CreateSyntheticStage(adapter.Get(), factory.Get())) ||
+      !CreateCompositionTree(angle_dxgi_device.Get()) ||
+      (external_stage() && !CreateExternalStagePlaceholder()) ||
+      !CreateFlutterEglSurface(angle_device.Get())) {
+    return false;
+  }
+
+  stage_stop_event_ = ::CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  if (!stage_stop_event_) {
+    return Fail(HRESULT_FROM_WIN32(::GetLastError()),
+                "create Stage stop event");
+  }
+
+  state_->width.store(static_cast<uint32_t>(width_), std::memory_order_relaxed);
+  state_->height.store(static_cast<uint32_t>(height_),
+                       std::memory_order_relaxed);
+  state_->capabilities.store(
+      synthetic_stage() ? kSyntheticCapabilities : kExternalCapabilities,
+      std::memory_order_release);
+  state_->initialization_hresult.store(S_OK, std::memory_order_release);
+  state_->last_resize_hresult.store(S_OK, std::memory_order_release);
+  state_->last_stage_resource_hresult.store(S_OK, std::memory_order_release);
+  state_->active.store(true, std::memory_order_release);
+  valid_ = true;
+  StartStageProducer();
+  return true;
+}
+
+bool CompositionWindowSurface::CreateFlutterSwapChain(
+    ID3D11Device* angle_device,
+    IDXGIFactory2* factory) {
+  const DXGI_SWAP_CHAIN_DESC1 description =
+      MakeCompositionSwapChainDescription(width_, height_, 0);
+  Microsoft::WRL::ComPtr<IDXGISwapChain1> swap_chain;
+  HRESULT result = factory->CreateSwapChainForComposition(
+      angle_device, &description, nullptr, &swap_chain);
+  if (FAILED(result)) {
+    return Fail(result, "create Flutter composition swapchain");
+  }
+  result = swap_chain.As(&flutter_swap_chain_);
+  if (FAILED(result)) {
+    return Fail(result, "query Flutter IDXGISwapChain3");
+  }
+  return true;
+}
+
+bool CompositionWindowSurface::CreateSyntheticStage(IDXGIAdapter* adapter,
+                                                    IDXGIFactory2* factory) {
+  const DXGI_SWAP_CHAIN_DESC1 description =
+      MakeCompositionSwapChainDescription(width_, height_, 0);
+  Microsoft::WRL::ComPtr<IDXGISwapChain1> swap_chain;
+  HRESULT result = factory->CreateSwapChainForComposition(
+      stage_device_.Get(), &description, nullptr, &swap_chain);
+  if (FAILED(result)) {
+    return Fail(result, "create Stage composition swapchain");
+  }
+  result = swap_chain.As(&stage_swap_chain_);
+  if (FAILED(result)) {
+    return Fail(result, "query Stage IDXGISwapChain3");
+  }
+
+  return true;
+}
