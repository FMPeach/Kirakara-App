+#ifdef _WIN32
+TEST_F(SubprocessTest, UnicodeCommandLine) {
+  const wchar_t* wide_path = L"ninja-unicode-\x6D4B\x8BD5.tmp";
+  DeleteFileW(wide_path);
+  HANDLE file = CreateFileW(wide_path, GENERIC_WRITE, 0, NULL, CREATE_NEW,
+                            FILE_ATTRIBUTE_NORMAL, NULL);
+  ASSERT_NE(INVALID_HANDLE_VALUE, file);
+  ASSERT_TRUE(CloseHandle(file));
+
+  const char* utf8_path =
+      "ninja-unicode-\xE6\xB5\x8B\xE8\xAF\x95.tmp";
+  string command = "cmd.exe /d /c if exist \"" + string(utf8_path) +
+                   "\" (exit /b 0) else (exit /b 1)";
+  Subprocess* subproc = subprocs_.Add(command);
+  ASSERT_NE((Subprocess *) 0, subproc);
+  while (!subproc->Done())
+    subprocs_.DoWork();
+  ExitStatus status = subproc->Finish();
+  EXPECT_TRUE(DeleteFileW(wide_path));
+  EXPECT_EQ(ExitSuccess, status);
+}
+#endif
